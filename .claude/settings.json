{
  "permissions": {
    "additionalDirectories": [
      "/Users/jacksonmurphy/Dev/trading_machine-2/data/processed",
      "/tmp",
      "/Users/jacksonmurphy/Dev/trading_machine-2/docs/Sessions"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash .claude/hooks/sessionstart_context.sh 2>/dev/null; exit 0'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'bash .claude/hooks/stop_freshness.sh; exit 0'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'path=$(echo \"$CLAUDE_TOOL_INPUT\" | jq -r .file_path 2>/dev/null); if [[ \"$path\" == *engines/*.py ]] && [[ -f scripts/sync_docs.py ]]; then python scripts/sync_docs.py 2>&1 | tail -5; fi; exit 0'"
          }
        ]
      }
    ]
  }
}