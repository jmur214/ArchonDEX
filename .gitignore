# Python & system
__pycache__/
*.pyc
*.pyo
*.pyd
*.DS_Store
.venv/
.pytest_cache/

# IDE
.vscode/
.idea/

# Local configs & secrets
.env
.env.*
config/alpaca_keys.json

# Local working snapshots of config files (before-risky-change backups
# made on individual machines — not project history)
config/*.backup
config/*.backup-*
config/*-backup
config/*.pre-*
config/*.bak

# Logs and runtime data
data/
logs/
evolution.log
storage/*.json
storage/*.csv

# Aider
.aider*

# Claude Code personal/runtime state (keep door open for team-wide
# .claude/settings.json, .claude/agents/, .claude/commands/ if desired)
.claude/settings.local.json
.claude/*.lock
.claude/plans/

# Archived info.
# DO NOT blanket-ignore Archive/ — "Archive, never delete" (CLAUDE.md) relies
# on git history to preserve archived code/docs. A bare `Archive/` silently
# untracks every archival (the data-loss trap the 2026-06 doc-system audit
# caught: a ~16K-LOC archive would have vanished). Ignore stray archived DATA
# only; ALWAYS track the source/doc archives below.
Archive/
!/Archive/
!/Archive/**
!/docs/Archive/
!/docs/Archive/**
# Agent worktree isolation directories (created by Agent tool isolation:worktree)
.claude/worktrees/

# Three-session coordination protocol files live in two places:
#   docs/Coordination/  → tracked (PROTOCOL.md, bootstraps, queue template)
#   data/coordination/  → gitignored (already covered by `data/` rule above);
#                         holds inbox/outbox/queue files symlinked across
#                         agent worktrees. See docs/Coordination/PROTOCOL.md.
#
# Guard rail (T-073): if a director accidentally writes a runtime inbox/
# outbox/queue file into docs/Coordination/ instead of data/coordination/,
# gitignore it so the orphan can't be committed. The runtime files belong
# under data/coordination/ only — symlinked from each agent worktree.
docs/Coordination/agent_*_inbox.md
docs/Coordination/agent_*_outbox.md
docs/Coordination/task_queue.md
data/external/aqr/
data/external/base_curve/
data/external/vrp/
