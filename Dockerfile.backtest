# Dockerfile.backtest — deterministic execution environment for substrate
# measurements and backtest-only workloads. Designed for AWS Batch / ECR.
#
# Determinism guarantees:
#   - Pinned base image digest (Python 3.14 slim)
#   - All deps from requirements.lock.txt (90 packages, every transitive dep
#     pinned via `pip freeze`)
#   - PYTHONHASHSEED=0 to lock dict iteration order
#   - LC_ALL=C.UTF-8 for stable string formatting
#   - data/processed/ + data/raw/ baked at build time so a given image tag
#     always sees the same input data
#
# Usage (local determinism check, see scripts/verify_container_determinism.sh):
#   docker build -f Dockerfile.backtest -t archondex-backtest:dev .
#   docker run --rm -v $(pwd)/data/trade_logs:/app/data/trade_logs \
#              --env-file .env archondex-backtest:dev \
#              python -m scripts.run_isolated --runs 1 --task q1
#
# IMPORTANT — secrets:
#   The .dockerignore excludes .env and config/alpaca_keys*.json. Pass them
#   at runtime via --env-file or AWS Secrets Manager. NEVER COPY them in.

# ---------- builder stage: install pinned deps into a virtualenv ----------
#
# T-2026-06-06-125: base pinned by manifest-list digest (was previously
# the mutable tag `python:3.14-slim`). The mutable tag could resolve to
# a different image on each rebuild → silent base-layer drift between
# the May-28 working image (--runs 3 = 3/3) and the 2026-06-06 T-109
# rebuild (--runs 3 = 2/3, 1/3 drift to b17bb3953b9e…). The digest below
# is the multi-arch index digest from `docker buildx imagetools inspect
# python:3.14-slim` on 2026-06-06; resolves to the linux/amd64 manifest
# `sha256:7d8de339aa8619f9b25e7d474d687ae4f6ef9704adad90a136af0f485adec
# cb7` for Fargate (x86_64). To bump, re-run that inspect and update
# BOTH stages atomically (builder + runtime) in the same commit.
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        libxml2-dev \
        libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy lockfile first so the deps layer caches independently of source changes
COPY requirements.lock.txt .

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.lock.txt

# ---------- runtime stage: minimal image with only what's needed -----------
# T-125: runtime stage MUST pin to the SAME digest as the builder stage
# above. Mismatched stages would re-introduce the drift the pin is
# meant to close.
FROM python:3.14-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS runtime

# Runtime libs that the C-extension wheels depend on (lxml, pyarrow, etc.)
# Plus awscli for S3 upload from the cloud entrypoint script (~30MB).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libxml2 \
        libxslt1.1 \
        awscli \
    && rm -rf /var/lib/apt/lists/*

# Bring in the pre-built virtualenv from the builder
COPY --from=builder /opt/venv /opt/venv

# Determinism env vars — applied to every process in the image.
# OMP/OpenBLAS/MKL thread pinning is critical: numpy parallel reductions are
# order-dependent on thread count. Without these pins, an 8-vCPU host and a
# 1-vCPU Fargate worker produce different canon md5s for the same input.
# Verified 2026-05-09: local container 8-thread (md5 d9d7c5...) vs Fargate
# 1-thread (md5 4d2bc3...) drifted on the same Q1 input.
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    TZ=UTC \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1

# Non-root user (UID 1000 to match common host UIDs and avoid mount perms issues)
RUN useradd --create-home --uid 1000 archondex
WORKDIR /app

# Copy source code FIRST (changes more often than data → cache-friendlier).
# All top-level Python packages the backtest harness imports.
# DELIBERATELY excluded: live_trader/ (CLAUDE.md forbids cloud exercise
# without user approval); cockpit/ (UI, not needed for headless backtest);
# tests/ (test fixtures shouldn't ship in production image); logs/ (runtime
# output, regenerable).
COPY --chown=archondex:archondex backtester/ ./backtester/
COPY --chown=archondex:archondex core/ ./core/
COPY --chown=archondex:archondex engines/ ./engines/
COPY --chown=archondex:archondex orchestration/ ./orchestration/
COPY --chown=archondex:archondex analytics/ ./analytics/
COPY --chown=archondex:archondex brokers/ ./brokers/
COPY --chown=archondex:archondex utils/ ./utils/
COPY --chown=archondex:archondex research/ ./research/
# cockpit: top-level logger.py + metrics.py needed by orchestration/.
# dashboard_v2/ is excluded via .dockerignore (UI not needed for backtests).
COPY --chown=archondex:archondex cockpit/ ./cockpit/
COPY --chown=archondex:archondex scripts/ ./scripts/

# Config + data layer
COPY --chown=archondex:archondex config/ ./config/
# This wholesale copy bakes the OHLCV _1d.csv/parquet AND, per T-2026-06-17-180,
# data/processed/fundamentals_simfin.parquet — the SimFin PIT panel the 4
# value/accruals edges read (simfin_adapter.load_panel). It is a tracked +
# manifest-pinned input (config/substrate_manifest.sha256 @ 6e36e42d). A fresh
# image therefore CARRIES it; the loader (simfin_adapter._ensure_simfin_configured)
# reads it offline without SIMFIN_API_KEY — without this the hermetic cloud went
# simfin-blind (T-175 finding). data/raw/simfin/*.csv (baked below) is its source.
COPY --chown=archondex:archondex data/processed/ ./data/processed/
COPY --chown=archondex:archondex data/raw/ ./data/raw/

# T-2026-06-13-164: bake the PIT S&P-500 membership panel so the cloud resolver
# uses the real historical universe (not the static fallback it hits when the
# file is absent) — pinned in substrate_manifest.sha256 against silent drift.
# File only (NOT data/universe/, which holds the rebuildable scrape cache).
COPY --chown=archondex:archondex data/universe/sp500_membership.parquet ./data/universe/sp500_membership.parquet

# T-2026-06-18-210/215: bake the market-cap snapshot join so the realistic-retail
# cost mode (realistic_retail_costs=true) actually applies cap-tier half-spreads in
# the cloud. WITHOUT it the cap cache loads empty -> every ticker silently falls
# back to the ADV bucket -> the realistic-cost mode is INERT (the honest robo-gate
# cell would then under-cost on the cloud, a silent fail-open). Pinned in the
# manifest against drift. (Delisted PIT names have no current cap -> ADV fallback;
# true PIT cap history is a Norgate/FMP follow-on, T-210 limitation.)
COPY --chown=archondex:archondex data/universe/market_cap_tiers.json ./data/universe/market_cap_tiers.json

# T-2026-06-13-164 GAP 2: bake the macro panel (VIX family + FRED series). It
# was NEVER copied, so the regime detector (engines/engine_e_regime/
# macro_features.py: vix_level/vix_term_spread/vix_zscore_60d) had no VIX in the
# cloud → regime degraded to "unknown" on EVERY cloud run ever, starving the
# HMM/de-gross overlay (C's T-118fc). 1 MB; pinned in the substrate manifest.
COPY --chown=archondex:archondex data/macro/ ./data/macro/

# Governor templates (run_isolated.py snapshots+restores these per run, so
# the in-image copy is the seed state, not mutated state)
COPY --chown=archondex:archondex data/governor/ ./data/governor/

# Re-pin #1 (2026-11-05, T-375 C6; the record's §0 second blocker). The honest-N gate
# (core/measurement/mbl_gate.py: DEFAULT_ARTIFACT_DIR / DEFAULT_PIN_PATH ->
# config/honest_n_pin.json) reads its two inputs from data/observability/, which this
# image created EMPTY — so Discovery's Gate 0 raised HonestNUnavailableError on every
# cloud run (the right fail-closed answer; this is the fix). COPY exactly the two files
# the pin names, BY NAME — never data/observability/ (run logs, S3 mirrors; the
# directory stays .dockerignored, with `!` exceptions for exactly these two) — then
# verify the pin: exit 3 fails the build, so the image cannot ship an N its pin
# disagrees with. Both files are substrate-pinned by name (scripts/
# gen_substrate_manifest.py SUBSTRATE_FILES, C1), so the CI's S3 sync of the
# content-addressed prefix carries them and build_backtest_image.sh stages them.
COPY --chown=archondex:archondex data/observability/n_effective_2026-09-30.json ./data/observability/n_effective_2026-09-30.json
COPY --chown=archondex:archondex data/observability/run_registry.sqlite ./data/observability/run_registry.sqlite
RUN python -m scripts.honest_n_pin --verify

# Root-level Python modules imported by the backtest harness
COPY --chown=archondex:archondex debug_config.py ./

# The edges.yml single-writer unit (2026-10-22, R §2): imports never write the registry, so the
# image carries the last SYNCED state of the building machine. This check writes nothing and
# fails the build when the baked registry disagrees with its own code (an edge module registers
# something the file lacks, or a code-owned field drifted) — an image cannot ship a registry its
# code disagrees with. Network dead-ended by construction while the edge modules import.
# RE-TARGETED 2026-11-05 (re-pin #1 D5, the first CI run that reached this step with the new prefix): the
# registry a cell EXECUTES from is `data/governor/_isolated_anchor/edges.yml` — run_isolated restores the
# whole governor set from the anchor ON ENTRY — and the live `data/governor/edges.yml` is deliberately NOT
# baked (T-133; build_backtest_image.sh excludes it), so a check against the default path read an absent file
# (0 rows) and could never pass in CI, while certifying nothing about the file that runs. The anchor's
# registry is pinned in the substrate manifest; a code/anchor disagreement here is a REAL defect (the
# anchor needs `run_isolated --save-anchor` + a re-pin — a canon change, director-coordinated), never a
# reason to loosen this line.
RUN python scripts/sync_edge_registry.py --check --registry data/governor/_isolated_anchor/edges.yml

# Pre-create the trade_logs mount point so a runtime volume mount succeeds
# even when the host hasn't pre-created the directory. trade_logs is empty in
# the image; data/observability already holds the two pinned honest-N files
# COPYd above — `mkdir -p` leaves an existing directory and its files in place
# (it never clobbers), and the chown -R re-owns them to archondex (idempotent).
RUN mkdir -p /app/data/trade_logs /app/data/observability \
    && chown -R archondex:archondex /app/data/trade_logs /app/data/observability

USER archondex

# Default command: print Python version + show that core imports work.
# Real workloads override this with `docker run ... <command>`.
CMD ["python", "-c", "import sys, pandas, numpy, hmmlearn, scipy; print('python', sys.version); print('pandas', pandas.__version__); print('numpy', numpy.__version__); print('CONTAINER_OK')"]
